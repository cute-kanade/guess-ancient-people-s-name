<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="UTF-8">
<title>猜历史人物 - 主界面 v3.0</title>
<HTA:APPLICATION
    ID="GuessApp03"
    APPLICATIONNAME="猜历史人物 v3.0"
    BORDER="thick"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="maximize"
    SCROLL="auto"
    NAVIGABLE="yes"
/>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        min-height: 100vh;
        background: #0a0a0f;
        font-family: 'KaiTi', 'STKaiti', 'SimSun', serif;
        padding: 20px;
        overflow-x: hidden;
        color: #fff;
    }

    /* ===== 主布局用 inline-block 实现响应式 ===== */
    .main-container {
        text-align: center; /* 居中列 */
        width: 100%;
        max-width: 1300px;
        margin: 40px auto 0 auto;
        font-size: 0; /* 消除 inline-block 间隙 */
    }

    .main-cell {
        display: inline-block;
        vertical-align: top;
        width: 35%; /* 左右列宽度 */
        font-size: 16px; /* 恢复字体大小 */
        padding: 0 15px;
        margin-bottom: 30px;
    }

    .main-cell-center {
        display: inline-block;
        vertical-align: middle;
        text-align: center;
        width: 20%; /* 中间标题列宽度 */
        font-size: 16px;
        padding: 0 15px;
        margin-bottom: 30px;
    }

    /* ===== 中间标题 - 竖写 ===== */
    .center-title {
        display: inline-block;
        writing-mode: tb-rl;
        font-family: 'KaiTi', 'STKaiti', cursive;
        font-size: 60px;
        font-weight: 900;
        color: #6b3a1f;
        background: #87CEEB;
        padding: 40px 28px;
        border-radius: 16px;
        letter-spacing: 12px;
        border: 2px solid #5ba3c7;
        box-shadow: 0 8px 24px rgba(135, 206, 235, 0.2);
        text-shadow: 2px 2px 4px rgba(255,255,255,0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .center-title:hover {
        transform: scale(1.02);
        box-shadow: 0 12px 32px rgba(135, 206, 235, 0.3);
    }

    /* ===== 左：中国古代 母框 ===== */
    .section-header-china {
        background: #b71c1c;
        color: #ffd700;
        font-size: 42px;
        font-weight: 900;
        font-family: 'KaiTi', 'STKaiti', cursive;
        padding: 18px 30px;
        border-radius: 14px;
        text-align: center;
        letter-spacing: 8px;
        border: 2px solid #ff8f00;
        margin-bottom: 24px;
        box-shadow: 0 6px 16px rgba(183, 28, 28, 0.4);
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }

    /* ===== 右：欧洲 母框 ===== */
    .section-header-europe {
        background: #1b5e20;
        color: #8e44ad;
        font-size: 42px;
        font-weight: 900;
        font-family: 'SimHei', 'Microsoft YaHei', sans-serif;
        padding: 18px 30px;
        border-radius: 14px;
        text-align: center;
        letter-spacing: 8px;
        border: 2px solid #6a1b9a;
        margin-bottom: 24px;
        box-shadow: 0 6px 16px rgba(27, 94, 32, 0.4);
        text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
    }

    /* ===== 左侧选项：黑底白字楷体 ===== */
    .option-china {
        display: block;
        background: #1a1a2e;
        color: #f0f0f0;
        font-family: 'KaiTi', 'STKaiti', serif;
        font-size: 20px;
        font-weight: 700;
        padding: 16px 20px;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        letter-spacing: 4px;
        border: 1px solid #333;
        margin-bottom: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }

    .option-china:hover {
        background: #2a1a1a;
        border-color: #ffd700;
        color: #ffd700;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(255, 215, 0, 0.15);
    }

    .option-china.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        box-shadow: none;
    }

    .option-china.disabled:hover {
        background: #1a1a2e;
        border-color: #333;
        color: #f0f0f0;
        transform: none;
        box-shadow: none;
    }

    /* ===== 右侧选项：白底黑字 ===== */
    .option-europe {
        display: block;
        background: #e8e8e0;
        color: #1a1a1a;
        font-family: 'SimHei', 'Microsoft YaHei', sans-serif;
        font-size: 20px;
        font-weight: 700;
        padding: 16px 20px;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        letter-spacing: 4px;
        border: 1px solid #ccc;
        margin-bottom: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .option-europe:hover {
        background: #d0c8e0;
        border-color: #8e44ad;
        color: #6b2d8b;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(142, 68, 173, 0.2);
    }

    .option-europe.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        box-shadow: none;
    }

    .option-europe.disabled:hover {
        background: #e8e8e0;
        border-color: #ccc;
        color: #1a1a1a;
        transform: none;
        box-shadow: none;
    }

    /* ===== 底部署名 ===== */
    .footer {
        margin-top: 40px;
        color: #555;
        font-size: 15px;
        letter-spacing: 2px;
        text-align: center;
    }

    .footer-note {
        margin-top: 10px;
        color: #444;
        font-size: 13px;
        letter-spacing: 1px;
        text-align: center;
        font-family: 'KaiTi', 'STKaiti', serif;
    }

    /* ===== 标签 ===== */
    .tag {
        display: inline-block;
        font-size: 11px;
        padding: 3px 8px;
        border-radius: 12px;
        margin-left: 8px;
        vertical-align: middle;
        font-weight: bold;
        letter-spacing: 0;
        text-shadow: none;
    }

    .tag-v3 {
        background: #004d40;
        color: #69f0ae;
        border: 1px solid #69f0ae;
    }

    .tag-ready {
        background: #1b4332;
        color: #2ecc71;
        border: 1px solid #2ecc71;
    }

    .tag-dev {
        background: #3d2e00;
        color: #f1c40f;
        border: 1px solid #f1c40f;
    }

    .tag-dev-dark {
        background: #2a2200;
        color: #bfa200;
        border: 1px solid #bfa200;
    }

    /* ===== 模态框 ===== */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        z-index: 1000;
    }

    .modal {
        background: #1e1e2e;
        border: 1px solid #444;
        border-radius: 20px;
        padding: 40px 36px;
        width: 480px;
        max-width: 90%;
        color: #e0e0e0;
        font-family: 'KaiTi', 'SimSun', serif;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        box-shadow: 0 15px 40px rgba(0,0,0,0.8);
    }
    
    /* IE fallback for transform translate */
    @media screen\0 {
        .modal {
            margin-top: -260px;
            margin-left: -240px;
            transform: none;
        }
    }

    .modal h2 {
        font-size: 26px;
        margin-bottom: 20px;
        color: #ffd700;
        text-align: center;
        letter-spacing: 3px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    }

    .modal-subtitle {
        font-size: 15px;
        color: #999;
        text-align: center;
        margin-bottom: 24px;
        background: #2a2a3e;
        padding: 8px;
        border-radius: 8px;
    }

    .modal label {
        display: block;
        font-size: 15px;
        color: #aaa;
        margin-bottom: 8px;
        margin-top: 16px;
        font-weight: bold;
    }

    .modal select,
    .modal input {
        width: 100%;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid #444;
        background: #2a2a3e;
        color: #e0e0e0;
        font-size: 16px;
        font-family: inherit;
        transition: border-color 0.3s;
    }
    
    .modal select:focus,
    .modal input:focus {
        border-color: #ffd700;
        outline: none;
    }

    .modal select option {
        background: #1e1e2e;
        color: #e0e0e0;
    }

    .modal-buttons {
        margin-top: 30px;
        text-align: right;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 8px;
        border: none;
        font-size: 16px;
        font-family: inherit;
        font-weight: bold;
        cursor: pointer;
        letter-spacing: 2px;
        margin-left: 12px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: #b71c1c;
        color: #ffd700;
        box-shadow: 0 4px 10px rgba(183, 28, 28, 0.4);
    }

    .btn-primary:hover {
        background: #d32f2f;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(211, 47, 47, 0.5);
    }

    .btn-cancel {
        background: #333;
        color: #aaa;
        border: 1px solid #555;
    }

    .btn-cancel:hover {
        background: #444;
        color: #fff;
        border-color: #777;
    }

    .hint-text {
        font-size: 12px;
        color: #777;
        margin-top: 6px;
    }

    /* ===== 提示条 ===== */
    .toast {
        display: none;
        position: fixed;
        top: 30px;
        left: 50%;
        margin-left: -200px;
        width: 400px;
        background: #2ecc71;
        color: #fff;
        padding: 16px 28px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: bold;
        z-index: 2000;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }

    .toast-error {
        background: #e74c3c;
    }

    /* ===== 响应式设计 (Media Queries) ===== */
    @media (max-width: 950px) {
        .main-cell {
            display: block;
            width: 90%;
            margin: 0 auto 30px auto;
        }
        
        .main-cell-center {
            display: block;
            width: 90%;
            margin: 0 auto 40px auto;
        }

        .center-title {
            writing-mode: horizontal-tb;
            padding: 20px 40px;
            font-size: 50px;
            letter-spacing: 16px;
            display: block;
        }
        
        .section-header-china, .section-header-europe {
            font-size: 36px;
        }
    }
    
    @media (max-width: 600px) {
        .center-title {
            font-size: 36px;
            letter-spacing: 8px;
            padding: 15px 20px;
        }
        .option-china, .option-europe {
            font-size: 18px;
            padding: 12px 16px;
        }
        .modal {
            width: 95%;
            padding: 30px 20px;
        }
    }
</style>
</head>
<body>

    <div id="toast" class="toast"></div>

    <div class="main-container">
        <!-- 左侧：中国古代 -->
        <div class="main-cell">
            <div class="section-header-china">中国古代</div>
            <div>
                <a class="option-china" id="btn-china-v3-1000" href="#" onclick="openApiModal('全古代1000人', 'app.py'); return false">
                    全古代1000人 <span class="tag tag-v3">v3.0</span><span class="tag tag-ready">可用</span>
                </a>
                <a class="option-china" id="btn-china-v3-200" href="#" onclick="openApiModal('全古代200人', 'app_03_mini.py'); return false">
                    全古代200人 <span class="tag tag-v3">v3.0</span><span class="tag tag-ready">可用</span>
                </a>
                <a class="option-china disabled" id="btn-chunqiu" href="#" onclick="return false">
                    春秋战国200人 <span class="tag tag-dev">开发中</span>
                </a>
                <a class="option-china disabled" id="btn-qinhan" href="#" onclick="return false">
                    秦、西汉200人 <span class="tag tag-dev">开发中</span>
                </a>
                <a class="option-china disabled" id="btn-sanguo" href="#" onclick="return false">
                    汉末三国200人 <span class="tag tag-dev">开发中</span>
                </a>
                <a class="option-china disabled" id="btn-suitang" href="#" onclick="return false">
                    隋唐200人 <span class="tag tag-dev">开发中</span>
                </a>
                <a class="option-china" id="btn-ming" href="#" onclick="openApiModal('明朝200人', 'app_03_ming.py'); return false">
                    明朝200人 <span class="tag tag-v3">v3.0</span><span class="tag tag-ready">可用</span>
                </a>
            </div>
        </div>

        <!-- 中间标题 -->
        <div class="main-cell-center">
            <div class="center-title" id="main-title">猜历史人物</div>
        </div>

        <!-- 右侧：欧洲 -->
        <div class="main-cell">
            <div class="section-header-europe">欧 洲</div>
            <div>
                <a class="option-europe disabled" id="btn-europe-500" href="#" onclick="return false">
                    全欧500人 <span class="tag tag-dev-dark">开发中</span>
                </a>
                <a class="option-europe disabled" id="btn-france" href="#" onclick="return false">
                    法国200人 <span class="tag tag-dev-dark">开发中</span>
                </a>
                <a class="option-europe disabled" id="btn-uk" href="#" onclick="return false">
                    英国200人 <span class="tag tag-dev-dark">开发中</span>
                </a>
                <a class="option-europe disabled" id="btn-germany" href="#" onclick="return false">
                    德意志200人 <span class="tag tag-dev-dark">开发中</span>
                </a>
                <a class="option-europe disabled" id="btn-russia" href="#" onclick="return false">
                    俄罗斯200人 <span class="tag tag-dev-dark">开发中</span>
                </a>
                <a class="option-europe disabled" id="btn-greece" href="#" onclick="return false">
                    希腊200人 <span class="tag tag-dev-dark">开发中</span>
                </a>
                <a class="option-europe disabled" id="btn-rome" href="#" onclick="return false">
                    古罗马200人 <span class="tag tag-dev-dark">开发中</span>
                </a>
            </div>
        </div>
    </div>

    <div class="footer">猜历史人物 · 海龟汤 AI 游戏（v3.0 全量重构架构版）</div>
    <div class="footer-note">注：本游戏「古代」范围自三皇五帝至辛亥革命（1912），非官方史学以1840年为中国近代史开端之分界。</div>

    <!-- API 配置模态框 -->
    <div class="modal-overlay" id="apiModal">
        <div class="modal">
            <h2>⚙ LLM API 配置</h2>
            <div class="modal-subtitle" id="modalSubtitle">即将进入：加载中...</div>

            <label>选择模型提供商</label>
            <select id="providerSelect" onchange="onProviderChange()">
                <option value="zhipu" selected>智谱AI（GLM-4-Air）— 默认</option>
                <option value="deepseek">DeepSeek</option>
                <option value="openai">OpenAI（GPT-4o-mini）</option>
                <option value="xai">xAI（Grok-2）</option>
                <option value="custom">自定义</option>
            </select>

            <label>API Key</label>
            <input type="password" id="apiKeyInput" value="">
            <div class="hint-text">如果配置了 secrets.toml 或环境变量，此项可留空。</div>

            <label>API URL</label>
            <input type="text" id="apiUrlInput" value="https://open.bigmodel.cn/api/paas/v4/chat/completions">

            <label>模型名称</label>
            <input type="text" id="modelInput" value="glm-4-air">

            <div class="modal-buttons">
                <button class="btn btn-cancel" onclick="closeModal()">取消</button>
                <button class="btn btn-primary" onclick="confirmLaunch()">启动游戏</button>
            </div>
        </div>
    </div>

    <script language="javascript">
        // ===== 获取当前 HTA 文件所在目录 =====
        function getAppDir() {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                var htaPath = unescape(document.location.pathname);
                if (htaPath.charAt(0) === '/') {
                    htaPath = htaPath.substring(1);
                }
                htaPath = htaPath.replace(/\//g, "\\");
                return fso.GetParentFolderName(htaPath);
            } catch(e) {
                alert("获取路径失败: " + e.message);
                return "";
            }
        }

        // ===== 运行 streamlit =====
        function runStreamlit(pyFile) {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var appDir = getAppDir();
                if (!appDir) return;

                // 在 v3.0 中，我们直接调用对应的 app.py 等
                var cmd = 'cmd /c cd /d "' + appDir + '" && streamlit run ' + pyFile;
                shell.Run(cmd, 1, false);

                showToast("正在启动游戏，请稍候...", false);
            } catch(e) {
                showToast("启动失败: " + e.message, true);
            }
        }

        // ===== 提供商预设（与 config.py 一致） =====
        var PROVIDERS = {
            "zhipu": {
                url: "https://open.bigmodel.cn/api/paas/v4/chat/completions",
                model: "glm-4-air",
                defaultKey: "" // v3.0 推荐由环境变量或 secrets 提供，不硬编码
            },
            "deepseek": {
                url: "https://api.deepseek.com/v1/chat/completions",
                model: "deepseek-chat",
                defaultKey: ""
            },
            "openai": {
                url: "https://api.openai.com/v1/chat/completions",
                model: "gpt-4o-mini",
                defaultKey: ""
            },
            "xai": {
                url: "https://api.x.ai/v1/chat/completions",
                model: "grok-2",
                defaultKey: ""
            },
            "custom": {
                url: "",
                model: "",
                defaultKey: ""
            }
        };

        var pendingScript = "";
        var pendingTitle = "";

        // ===== 切换提供商 =====
        function onProviderChange() {
            var sel = document.getElementById("providerSelect").value;
            var p = PROVIDERS[sel];
            document.getElementById("apiUrlInput").value = p.url;
            document.getElementById("modelInput").value = p.model;
            document.getElementById("apiKeyInput").value = p.defaultKey;
        }

        // ===== 打开模态框 =====
        function openApiModal(title, script) {
            pendingScript = script;
            pendingTitle = title;
            document.getElementById("modalSubtitle").innerText = "即将进入：" + title;
            document.getElementById("providerSelect").value = "zhipu";
            onProviderChange();
            document.getElementById("apiModal").style.display = "block";
        }

        // ===== 关闭模态框 =====
        function closeModal() {
            document.getElementById("apiModal").style.display = "none";
        }

        // ===== 确认启动 =====
        function confirmLaunch() {
            var apiKey = document.getElementById("apiKeyInput").value;
            var provider = document.getElementById("providerSelect").value;
            
            // v3.0 允许 apiKey 为空，因为可能从环境变量或 secrets 中读取
            // 但如果用户选择 custom 且没有任何 url 等信息，则可以警告
            var apiUrl = document.getElementById("apiUrlInput").value;
            if (!apiUrl || apiUrl.replace(/\s/g, "") === "") {
                alert("请输入 API URL");
                return;
            }
            
            // 如果提供了 apiKey，则将其设置到环境变量中传递给 streamlit
            if (apiKey && apiKey.replace(/\s/g, "") !== "") {
                try {
                    var shell = new ActiveXObject("WScript.Shell");
                    var env = shell.Environment("PROCESS");
                    if (provider === "zhipu") {
                        env("ZHIPU_API_KEY") = apiKey;
                    } else {
                        env("LLM_API_KEY") = apiKey;
                    }
                } catch(e) {
                    // ignore
                }
            }

            runStreamlit(pendingScript);
            closeModal();
        }

        // ===== 提示条 =====
        function showToast(msg, isError) {
            var t = document.getElementById("toast");
            t.innerText = msg;
            t.className = isError ? "toast toast-error" : "toast";
            t.style.display = "block";
            setTimeout(function() {
                t.style.display = "none";
            }, 3000);
        }

        // ===== ESC 关闭模态框 =====
        document.onkeydown = function(e) {
            e = e || window.event;
            if (e.keyCode === 27) closeModal();
        };
    </script>
</body>
</html>